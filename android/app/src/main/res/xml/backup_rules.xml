<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 (API 30) and lower.
  Referenced from AndroidManifest.xml via android:fullBackupContent.

  Excludes the financial database and the app's preference files so their
  cleartext contents are never written to Google Drive Auto Backup or to an
  `adb backup` archive.

  Defense in depth: android:allowBackup is set to "false", which already
  disables every backup transport on all API levels. These exclusions keep
  the sensitive data out of backups even if allowBackup is ever flipped
  back to "true".

  With no <include> element, everything else is still backed up by default.
-->
<full-backup-content>
    <!-- Room database: full financial / transaction history (khata.db).
         Also list the SQLite sidecar files so a partial (corrupt) copy is
         never produced. -->
    <exclude domain="database" path="khata.db" />
    <exclude domain="database" path="khata.db-shm" />
    <exclude domain="database" path="khata.db-wal" />
    <exclude domain="database" path="khata.db-journal" />

    <!-- EncryptedSharedPreferences holding the auth token. Its AES master key
         lives in the Android Keystore and is never included in a backup, so a
         restored copy would be undecryptable regardless; excluded explicitly
         as defense in depth. -->
    <exclude domain="sharedpref" path="khata_secure_prefs.xml" />

    <!-- Plaintext prefs: user-configured server URL. -->
    <exclude domain="sharedpref" path="khata_server.xml" />

    <!-- Crash reports: stack traces / device info may embed sensitive data. -->
    <exclude domain="sharedpref" path="khata_crash_log.xml" />

    <!-- Crash / info logs written by CrashLogWriter to
         getExternalFilesDir(null)/crash_logs/ (exception messages + stack
         traces + device info). -->
    <exclude domain="external" path="crash_logs/" />
</full-backup-content>
