[Unit]
Description=Khata local Laya SMS decisions
After=network.target

[Service]
Type=simple
User=khata-laya
Group=khata-laya
WorkingDirectory=/opt/khata-laya
ExecStart=/opt/khata-laya/venv/bin/python -m uvicorn sms_service:app --host 127.0.0.1 --port 8091 --no-access-log --log-level warning
Environment=KHATA_LAYA_MODEL_DIR=/var/lib/khata-laya/model
Environment=HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TRANSFORMERS_OFFLINE=1
Environment=HF_HOME=/var/lib/khata-laya/cache TOKENIZERS_PARALLELISM=false USE_TF=0
Environment=PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=khata-laya
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
IPAddressDeny=any
IPAddressAllow=localhost
CPUQuota=150%
MemoryHigh=2500M
MemoryMax=3500M
TasksMax=64

[Install]
WantedBy=multi-user.target
