DATABASE_URL=postgresql://khata:khata@127.0.0.1:5433/khata
RO_DATABASE_URL=postgresql://khata_ro:khata_ro@127.0.0.1:5433/khata
JWT_SECRET=change-me-to-a-random-64-char-string-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CLAUDE_BIN=claude
BIND_ADDR=127.0.0.1:8090
CORS_ORIGINS=http://localhost:5173

# Auth cookie `Secure` attribute. Defaults to true. Set to false ONLY for local
# HTTP development without TLS. Do NOT disable in production: the backend runs
# behind a TLS-terminating reverse proxy, so BIND_ADDR alone is not a safe
# signal of transport security.
# COOKIE_SECURE=true

# For Cloudflare Tunnel: uncomment and update
# BIND_ADDR=0.0.0.0:8080
# CORS_ORIGINS=https://your-tunnel-domain.trycloudflare.com
# First-run admin setup (POST /api/auth/setup) is unauthenticated and is only
# allowed when BIND_ADDR is a loopback address. When BIND_ADDR is public (as
# above), set this to 1 to permit first-run setup, then create the admin
# account immediately and unset it.
# KHATA_ALLOW_REMOTE_SETUP=1

# ── Email statement ingestion ────────────────────────────────────────────
# Background poll interval (seconds). 0 disables the poll loop; manual
# POST /api/ingest/email/sync still works. Default 900.
# EMAIL_SYNC_POLL_SECS=900
# Max messages processed per sync run. Default 200.
# EMAIL_SYNC_MAX_MESSAGES=200
# Per-attachment size cap in bytes. Default 15 MiB.
# EMAIL_SYNC_MAX_ATTACH_BYTES=15728640
# NOTE: password-protected statement PDFs require `qpdf` on the host
#   (Oracle Linux: sudo dnf --enablerepo=ol9_developer_EPEL install qpdf)
